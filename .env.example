# MALLI – älä kirjoita tähän oikeita arvoja. Kopioi tiedostoksi .env.local ja täytä siellä.
# Supabase-projektin asetukset (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Vain palvelimella: piirrosten vastaanotto ja rate limit. Älä koskaan julkaise tätä.
SUPABASE_SERVICE_ROLE_KEY=
# Satunnainen merkkijono laitetunnisteiden hashaukseen (esim. `openssl rand -hex 32`).
LAITE_SUOLA=
# Cloudflare Turnstile (botintorjunta). Oletuksena Cloudflaren julkiset testiavaimet, jotka
# hyväksyvät aina. Tuotantoon oma widget (dash.cloudflare.com → Turnstile): Vercelin
# tuotannossa testiavainten tuloksia ei hyväksytä.
NEXT_PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Piirtonäkymän hostnimet pilkuilla eroteltuina. Testiavaimet palauttavat aina example.com.
# Tuotannossa vain oikea domain, ei localhostia.
TURNSTILE_HOSTNAMES=example.com
# Kioskiavainten salaisuus (esim. `openssl rand -hex 32`). Asennusosoitteet: npm run kioskiavain -- ipad-1
KIOSKI_SALAISUUS=
# Tekoälyesisuodatus (Claude Haiku 5.5): console.anthropic.com → API Keys. Vain palvelimelle.
# Ilman avainta piirrokset menevät moderointijonoon ilman tekoälyarviota.
ANTHROPIC_API_KEY=
