# MALLI – älä kirjoita tähän oikeita arvoja. Kopioi tiedostoksi .env.local ja täytä siellä.
# Supabase-projektin asetukset (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Vain palvelimella: piirrosten vastaanotto ja rate limit. Älä koskaan julkaise tätä.
SUPABASE_SERVICE_ROLE_KEY=
# Satunnainen merkkijono laitetunnisteiden hashaukseen (esim. `openssl rand -hex 32`).
LAITE_SUOLA=
